# Reference grammar for the C subset Slate translates.
#
# This is documentation, not a program generator: the fuzzer is
# tests/support/cgen.rs, which maintains scope/type state that a
# context-free grammar cannot express. This file records *which syntax*
# Slate supports, in one screen. The bnf_fuzz tests check that it parses
# and that every referenced rule is defined.
#
# Syntax: <rule> ::= alt | alt ;   terminals in "quotes", rules in <angles>.
# It is intentionally smaller than a full C grammar and covers only what
# Slate can currently lower (see docs/README.md).

<program> ::= <include> <decl_list> <function_list> ;

<include> ::= "#include <stdio.h>" ;

# ----- top-level declarations -----

<decl_list> ::= <decl> <decl_list> | <decl> ;
<decl> ::= <typedef_decl> | <enum_decl> | <struct_decl> | <union_decl> | <global_decl> ;

<typedef_decl> ::= "typedef" <type> <ident> ";" ;

<enum_decl> ::= "enum" <ident> "{" <enumerator_list> "};" ;
<enumerator_list> ::= <enumerator> "," <enumerator_list> | <enumerator> ;
<enumerator> ::= <ident> | <ident> "=" <int> ;

<struct_decl> ::= "struct" <ident> "{" <field_list> "};" ;
<union_decl> ::= "union" <ident> "{" <field_list> "};" ;
<field_list> ::= <field> <field_list> | <field> ;
<field> ::= "int" <ident> ";" ;

<global_decl> ::= "static" <type> <ident> "=" <const> ";" ;

# ----- functions -----

<function_list> ::= <function> <function_list> | <function> ;
<function> ::= <ret_type> <ident> "(" <param_list> ")" "{" <stmt_list> "}" ;
<ret_type> ::= <type> | "void" ;
<param_list> ::= "void" | <params> ;
<params> ::= <param> "," <params> | <param> ;
<param> ::= <type> <ident> ;

# ----- statements -----

<stmt_list> ::= <stmt> <stmt_list> | <stmt> ;
<stmt> ::= <declaration> | <assignment> | <compound_assignment> | <for_loop> | <while_loop> | <call_stmt> | <return_stmt> ;

<declaration> ::= <type> <ident> "=" <expr> ";" ;
<assignment> ::= <lvalue> "=" <expr> ";" ;
<compound_assignment> ::= <lvalue> "+=" <expr> ";" ;
<for_loop> ::= "for" "(" "int" <ident> "=" <expr> ";" <expr> ";" <ident> "++" ")" "{" <stmt_list> "}" ;
<while_loop> ::= "while" "(" <expr> ")" "{" <stmt_list> "}" ;
<call_stmt> ::= <call> ";" ;
<return_stmt> ::= "return" <expr> ";" | "return" ";" ;

# ----- expressions -----

<expr> ::= <term> | <term> <arith_op> <expr> | "(" <expr> <cmp_op> <expr> ")" ;
<term> ::= <int> | <float> | <char> | <lvalue> | <call> | <sizeof> | "(" <expr> ")" ;
<lvalue> ::= <ident> | <ident> "." <ident> | <ident> "[" <expr> "]" ;
<arith_op> ::= "+" | "-" | "*" | "/" | "%" ;
<cmp_op> ::= "<" | "<=" | ">" | ">=" | "==" | "!=" ;
<call> ::= <ident> "(" ")" | <ident> "(" <arg_list> ")" ;
<arg_list> ::= <expr> "," <arg_list> | <expr> ;
<sizeof> ::= "sizeof" "(" <sizeof_arg> ")" ;
<sizeof_arg> ::= "int" | <ident> | "struct" <ident> | "union" <ident> ;

# ----- types and lexical tokens -----

<type> ::= <int_type> | "volatile int" | "float" | "double" | <char_type> | <ident> ;
<int_type> ::= "int" | "unsigned int" | "short" | "unsigned short" | "long" | "unsigned long" | "long long" | "unsigned long long" ;
<char_type> ::= "char" | "signed char" | "unsigned char" ;

# Lexical placeholders: a real lexer supplies identifiers and numeric
# literals. They are single productions here so the grammar is self-contained.
<ident> ::= "name" ;
<const> ::= <int> | <float> | <char> ;
<int> ::= "0" ;
<float> ::= "0.0" | "0.0f" ;
<char> ::= "'A'" ;

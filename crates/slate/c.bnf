# Reference grammar for the C subset Slate translates.
#
# This is documentation, not a program generator: the fuzzer is
# tests/support/cgen.rs, which maintains scope/type state that a
# context-free grammar cannot express. This file records *which syntax*
# Slate supports, in one screen. The bnf_fuzz tests check that it parses
# and that every referenced rule is defined.
#
# Syntax: <rule> ::= alt | alt ;   terminals in "quotes", rules in <angles>.
# It is intentionally smaller than a full C grammar and covers only what
# Slate can currently lower (see docs/README.md).

<program> ::= <include_list> <decl_list> <function_list> ;

<include_list> ::= <include> <include_list> | <include> ;
<include> ::= "#include <stdio.h>" | "#include <stdint.h>" | "#include <stddef.h>" | "#include <stdbool.h>" | "#include <stdatomic.h>" ;

# ----- top-level declarations -----

<decl_list> ::= <decl> <decl_list> | <decl> ;
<decl> ::= <typedef_decl> | <enum_decl> | <struct_decl> | <union_decl> | <global_decl> ;

<typedef_decl> ::= "typedef" <type> <ident> ";" ;

<enum_decl> ::= "enum" <ident> "{" <enumerator_list> "};" ;
<enumerator_list> ::= <enumerator> "," <enumerator_list> | <enumerator> ;
<enumerator> ::= <ident> | <ident> "=" <int> ;

<struct_decl> ::= "struct" <ident> "{" <field_list> "};" ;
<union_decl> ::= "union" <ident> "{" <field_list> "};" ;
<field_list> ::= <field> <field_list> | <field> ;
<field> ::= <type> <ident> ";" ;

<global_decl> ::= <storage_class> <type> <ident> <global_init> ";" | <type> <ident> <global_init> ";" | "extern" <type> <ident> ";" ;
<storage_class> ::= "static" | "" ;
<global_init> ::= "=" <const> | "=" <aggregate_init> | "" ;
<aggregate_init> ::= "{" <const_list> "}" ;
<const_list> ::= <const> "," <const_list> | <const> ;

# ----- functions -----

<function_list> ::= <function> <function_list> | <function> ;
<function> ::= <ret_type> <ident> "(" <param_list> ")" "{" <stmt_list> "}" ;
<ret_type> ::= <type> | "void" ;
<param_list> ::= "void" | <params> ;
<params> ::= <param> "," <params> | <param> ;
<param> ::= <type> <ident> ;

# ----- statements -----

<stmt_list> ::= <stmt> <stmt_list> | <stmt> ;
<stmt> ::= <declaration> | <assignment> | <compound_assignment> | <atomic_stmt> | <for_loop> | <while_loop> | <if_stmt> | <switch_stmt> | <call_stmt> | <return_stmt> | <break_stmt> | <continue_stmt> | <goto_stmt> | <labeled_stmt> ;

<declaration> ::= <scalar_declaration> | <array_declaration> ;
<scalar_declaration> ::= <type> <ident> "=" <expr> ";" ;
<array_declaration> ::= <type> <ident> "[" <int> "]" ";" ;
<assignment> ::= <lvalue> "=" <expr> ";" ;
<compound_assignment> ::= <lvalue> <compound_assign_op> <expr> ";" ;
<for_loop> ::= "for" "(" "int" <ident> "=" <expr> ";" <expr> ";" <ident> "++" ")" "{" <stmt_list> "}" ;
<while_loop> ::= "while" "(" <expr> ")" "{" <stmt_list> "}" ;
<if_stmt> ::= "if" "(" <expr> ")" "{" <stmt_list> "}" <else_clause> ;
<else_clause> ::= "else" "{" <stmt_list> "}" | "else" <if_stmt> | "" ;
<switch_stmt> ::= "switch" "(" <expr> ")" "{" <case_list> <default_case> "}" ;
<case_list> ::= <case> <case_list> | <case> ;
<case> ::= "case" <int> ":" <stmt_list> ;
<default_case> ::= "default" ":" <stmt_list> | "" ;
<call_stmt> ::= <call> ";" ;
<atomic_stmt> ::= <atomic_store> ";" | <atomic_expr> ";" ;
<return_stmt> ::= "return" <expr> ";" | "return" ";" ;
<break_stmt> ::= "break" ";" ;
<continue_stmt> ::= "continue" ";" ;
<goto_stmt> ::= "goto" <ident> ";" ;
<labeled_stmt> ::= <ident> ":" <stmt> ;

# ----- expressions -----

<expr> ::= <term> | <unary_op> <term> | <term> <binary_op> <expr> | "(" <expr> <cmp_op> <expr> ")" | "(" <expr> <logical_op> <expr> ")" ;
<term> ::= <int> | <float> | <char> | <lvalue> | "&" <lvalue> | <cast_expr> | <call> | <function_pointer_call> | <atomic_expr> | <sizeof> | "(" <expr> ")" ;
<lvalue> ::= <ident> | "*" <term> | <ident> "." <ident> | <ident> "[" <expr> "]" ;
<binary_op> ::= <arith_op> | <bitwise_op> | <shift_op> ;
<arith_op> ::= "+" | "-" | "*" | "/" | "%" ;
<bitwise_op> ::= "&" | "|" | "^" ;
<shift_op> ::= "<<" | ">>" ;
<cmp_op> ::= "<" | "<=" | ">" | ">=" | "==" | "!=" ;
<logical_op> ::= "&&" | "||" ;
<unary_op> ::= "-" | "!" | "~" ;
<compound_assign_op> ::= "+=" | "-=" | "*=" | "/=" | "%=" | "<<=" | ">>=" | "&=" | "^=" | "|=" ;
<cast_expr> ::= "(" <type> ")" <term> ;
<call> ::= <ident> "(" ")" | <ident> "(" <arg_list> ")" ;
<function_pointer_call> ::= <lvalue> "(" <arg_list> ")" ;
<arg_list> ::= <expr> "," <arg_list> | <expr> ;
<sizeof> ::= "sizeof" "(" <sizeof_arg> ")" ;
<sizeof_arg> ::= "int" | <ident> | "struct" <ident> | "union" <ident> ;

# ----- single-threaded atomics -----

<atomic_store> ::= "atomic_store_explicit" "(" "&" <ident> "," <expr> "," <store_ordering> ")" ;
<atomic_expr> ::= <atomic_load> | <atomic_fetch> | <atomic_exchange> | <atomic_compare_exchange> ;
<atomic_load> ::= "atomic_load_explicit" "(" "&" <ident> "," <load_ordering> ")" ;
<atomic_fetch> ::= <atomic_fetch_op> "(" "&" <ident> "," <expr> "," <rmw_ordering> ")" ;
<atomic_fetch_op> ::= "atomic_fetch_add_explicit" | "atomic_fetch_sub_explicit" | "atomic_fetch_and_explicit" | "atomic_fetch_or_explicit" | "atomic_fetch_xor_explicit" ;
<atomic_exchange> ::= "atomic_exchange_explicit" "(" "&" <ident> "," <expr> "," <rmw_ordering> ")" ;
<atomic_compare_exchange> ::= "atomic_compare_exchange_strong_explicit" "(" "&" <ident> "," "&" <ident> "," <expr> "," <rmw_ordering> "," <load_ordering> ")" ;
<load_ordering> ::= "memory_order_relaxed" | "memory_order_consume" | "memory_order_acquire" | "memory_order_seq_cst" ;
<store_ordering> ::= "memory_order_relaxed" | "memory_order_release" | "memory_order_seq_cst" ;
<rmw_ordering> ::= "memory_order_relaxed" | "memory_order_acquire" | "memory_order_release" | "memory_order_acq_rel" | "memory_order_seq_cst" ;

# ----- types and lexical tokens -----

<type> ::= <base_type> | <pointer_type> | <function_pointer_type> ;
<base_type> ::= <unqualified_base_type> | <type_qualifier> <unqualified_base_type> ;
<unqualified_base_type> ::= <int_type> | "float" | "double" | "long double" | "__float128" | <complex_type> | <char_type> | <bool_type> | <ident> ;
<pointer_type> ::= <base_type> "*" | <base_type> "*" "restrict" ;
<function_pointer_type> ::= <ret_type> "(" "*" ")" "(" <function_pointer_param_types> ")" ;
<function_pointer_param_types> ::= "void" | <function_pointer_params> ;
<function_pointer_params> ::= <type> "," <function_pointer_params> | <type> ;
<type_qualifier> ::= "volatile" | "const" | "restrict" | "_Atomic" ;
<int_type> ::= "int" | "unsigned int" | "short" | "unsigned short" | "long" | "unsigned long" | "long long" | "unsigned long long" ;
<char_type> ::= "char" | "signed char" | "unsigned char" ;
<bool_type> ::= "_Bool" | "bool" ;
<complex_type> ::= "float" "_Complex" | "double" "_Complex" ;

# Lexical placeholders: a real lexer supplies identifiers and numeric
# literals. They are single productions here so the grammar is self-contained.
<ident> ::= "name" ;
<const> ::= <int> | <float> | <char> ;
<int> ::= "0" ;
<float> ::= "0.0" | "0.0f" ;
<char> ::= "'A'" ;

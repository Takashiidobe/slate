static mut counter: i32 = 2;

unsafe extern "C" {
    fn printf(_0: *const i8, ...) -> i32;
}

fn bump_counter() -> i32 {
    let mut __retval: i32 = 0;
    let _v0: i32 = unsafe { counter };
    let _v1: i32 = 1;
    let _v2: i32 = _v0 + _v1;
    unsafe {
        counter = _v2;
    }
    let _v3: i32 = unsafe { counter };
    __retval = _v3;
    let _v4: i32 = __retval;
    return _v4;
}

fn main() {
    let mut __retval: i32 = 0;
    let _v0: i32 = 0;
    __retval = _v0;
    let _v1: *mut i8 = b"%d\n\0".as_ptr() as *mut i8;
    let _v2: i32 = bump_counter();
    let _v3: i32 = unsafe { printf(_v1 as *const i8, _v2) };
    let _v4: *mut i8 = b"%d\n\0".as_ptr() as *mut i8;
    let _v5: i32 = bump_counter();
    let _v6: i32 = unsafe { printf(_v4 as *const i8, _v5) };
    let _v7: i32 = 0;
    __retval = _v7;
    let _v8: i32 = __retval;
    std::process::exit(_v8 as i32);
}

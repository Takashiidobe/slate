{
  "version": 1,
  "targets": {
    "linux-x86_64": {
      "triple": "x86_64-unknown-linux-gnu",
      "flavor": "clang",
      "compile_commands": "build-linux/compile_commands.json"
    },
    "linux-x86_64-gcc": {
      "triple": "x86_64-unknown-linux-gnu",
      "flavor": "gcc",
      "compile_commands": "build-linux/compile_commands.json"
    },
    "windows-x86_64": {
      "triple": "x86_64-pc-windows-msvc",
      "flavor": "msvc",
      "compile_commands": "build-windows/compile_commands.json"
    }
  },
  "features": {
    "fast": [
      "FAST"
    ],
    "level-two": [
      "LEVEL=2",
      "HAS_LEVEL"
    ],
    "small": [
      "SMALL"
    ]
  },
  "invalid_features": [
    [
      "fast",
      "small"
    ]
  ]
}

        {
          "name": "arm_little_endian",
          "predicate": "defined(__ARMEL__) || defined(__AARCH64EL__)",
          "rust_cfg": "any(all(target_arch = \"arm\", target_endian = \"little\"), all(target_arch = \"aarch64\", target_endian = \"little\"))",
          "expected_stdout": "200\n"
        }
      ],
      "fallback": {
        "rust_cfg": "not(any(any(all(target_arch = \"arm\", target_endian = \"big\"), all(target_arch = \"aarch64\", target_endian = \"big\")), any(all(target_arch = \"arm\", target_endian = \"little\"), all(target_arch = \"aarch64\", target_endian = \"little\"))))",
        "expected_stdout": "0\n"
      }
    },
    {
      "source": "ndebug.c",
      "variants": [
        {
          "name": "release",
          "predicate": "defined(NDEBUG)",
          "rust_cfg": "not(debug_assertions)",
          "expected_stdout": "0\n"
        },
        {
          "name": "debug",
          "predicate": "!defined(NDEBUG)",

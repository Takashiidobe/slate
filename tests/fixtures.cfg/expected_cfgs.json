          "expected_stdout": "32\n"
        },
        {
          "name": "powerpc64",
          "predicate": "defined(__powerpc64__) || defined(__PPC64__)",
          "rust_cfg": "target_arch = \"powerpc64\"",
          "expected_stdout": "640\n"
        },
        {
          "name": "powerpc",
          "predicate": "defined(__powerpc__) || defined(__POWERPC__) || defined(_M_PPC)",
          "rust_cfg": "target_arch = \"powerpc\"",
          "expected_stdout": "320\n"
        },
        {
          "name": "wasm64",
          "predicate": "defined(__wasm64__)",

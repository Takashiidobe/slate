{
  "fixtures": [
    {
      "source": "os_targets.c",
      "variants": [
        {
          "name": "windows",
          "predicate": "defined(_WIN32)",
          "rust_cfg": "windows",
          "expected_stdout": "10\n"
        },
        {
          "name": "android",
          "predicate": "defined(__ANDROID__)",
          "rust_cfg": "target_os = \"android\"",
          "expected_stdout": "25\n"
        },
        {
          "name": "linux",
          "predicate": "defined(__linux__)",
          "rust_cfg": "target_os = \"linux\"",
          "expected_stdout": "20\n"
        },
        {
          "name": "apple",
          "predicate": "defined(__APPLE__)",
          "rust_cfg": "target_vendor = \"apple\"",
          "expected_stdout": "30\n"
        },
        {
          "name": "freebsd",
          "predicate": "defined(__FreeBSD__)",
          "rust_cfg": "target_os = \"freebsd\"",
          "expected_stdout": "35\n"
        }
      ],
      "fallback": {
        "rust_cfg": "not(any(windows, target_os = \"android\", target_os = \"linux\", target_vendor = \"apple\", target_os = \"freebsd\"))",
        "expected_stdout": "40\n"
      }
    },
    {
      "source": "win64_target.c",
      "variants": [
        {
          "name": "win64",
          "predicate": "defined(_WIN64)",
          "rust_cfg": "all(windows, target_pointer_width = \"64\")",
          "expected_stdout": "64\n"
        }
      ],
      "fallback": {
        "rust_cfg": "not(all(windows, target_pointer_width = \"64\"))",
        "expected_stdout": "0\n"
      }
    },
    {
      "source": "unix_target.c",
      "variants": [
        {
          "name": "unix",
          "predicate": "defined(__unix__) || defined(__unix)",
          "rust_cfg": "unix",
          "expected_stdout": "1\n"
        }
      ],
      "fallback": {
        "rust_cfg": "not(unix)",
        "expected_stdout": "0\n"
      }
    },
    {

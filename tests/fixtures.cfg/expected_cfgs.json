          "expected_stdout": "6400\n"
        },
        {
          "name": "wasm32",
          "predicate": "defined(__wasm32__)",
          "rust_cfg": "target_arch = \"wasm32\"",
          "expected_stdout": "3200\n"
        },
        {
          "name": "riscv64",
